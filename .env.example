# Example environment variables for the Jira and Xray agent

# Jira connection credentials
JIRA_BASE_URL=https://your-instance.atlassian.net/
JIRA_USER=your-user@email.com
JIRA_PASSWORD=your-api-token-or-password
JIRA_PREFIX=PROJ

# Optional Network Proxy URL (e.g., http://proxy.example.com:8080 or http://user:pass@proxy.example.com:8080)
# Leave empty if no proxy is needed
JIRA_PROXY=

# LLM Configuration (OpenAI or Local OpenAI-compatible REST API like Ollama/LM Studio/vLLM)
# To use a local model (e.g., Gemma 2), set LLM_BASE_URL to your local endpoint and OPENAI_MODEL_NAME to the local model name
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL_NAME=gpt-4o-mini
LLM_BASE_URL=

# Enable or disable Xray integration (true/false)
ENABLE_XRAY=true
